{
  "name": "gogyo-village",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "gogyo-village-images" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY", "class_name": "VillageRegistry" },
      { "name": "ROOM", "class_name": "VillageRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VillageRegistry", "VillageRoom"] }
  ]
}
